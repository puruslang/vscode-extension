{
  "name": "purus",
  "displayName": "Purus",
  "description": "Purus language support — syntax highlighting, snippets, and file icons",
  "version": "1.1.0",
  "publisher": "otoneko1102",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsdown",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vscode:prepublish": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:purus"
  ],
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "icon": "icon.png",
  "homepage": "https://purus.work",
  "keywords": [
    "purus",
    "altjs",
    "lang",
    "language",
    "noshift"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/puruslang/vscode-extension"
  },
  "contributes": {
    "languages": [
      {
        "id": "purus",
        "aliases": [
          "Purus",
          "purus"
        ],
        "extensions": [
          ".purus",
          ".cpurus",
          ".mpurus"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/purus-icon-light.svg",
          "dark": "./icons/purus-icon-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "purus",
        "scopeName": "source.purus",
        "path": "./syntaxes/purus.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "purus",
        "path": "./snippets/purus.json"
      }
    ],
    "iconThemes": [
      {
        "id": "purus-icons",
        "label": "Purus File Icons (supplement)",
        "path": "./icons/purus-icon-theme.json"
      }
    ],
    "keybindings": [
      {
        "key": "/",
        "command": "purus.surroundSlash",
        "when": "editorTextFocus && editorHasSelection && editorLangId == 'purus'"
      }
    ]
  },
  "bugs": {
    "url": "https://github.com/puruslang/vscode-extension/issues"
  }
}
